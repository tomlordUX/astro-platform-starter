---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Projects">
    <h1 class="mb-10">Projects</h1>
    <ul class="grid gap-10 sm:grid-cols-2">
        {
            projects.map((project) => (
                <li>
                    <a href={`/projects/${project.id}/`} class="block no-underline">
                        {project.data.cover && <img src={project.data.cover} alt="" class="w-full mb-4 rounded" />}
                        <h2>{project.data.title}</h2>
                        {project.data.summary && <p class="mt-2">{project.data.summary}</p>}
                    </a>
                </li>
            ))
        }
    </ul>
</Layout>
