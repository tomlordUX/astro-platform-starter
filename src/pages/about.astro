---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(about);
---

<Layout title={about.data.title}>
    <h1 class="mb-10">{about.data.title}</h1>
    {about.data.portrait && <img src={about.data.portrait} alt="" class="max-w-xs mb-10 rounded" />}
    <div class="markdown">
        <Content />
    </div>
</Layout>
